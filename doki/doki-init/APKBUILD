pkgname=doki-init
pkgver=0.10.0
pkgrel=0
pkgdesc="PID 1 for doki-OS VM and microVM"
url="https://github.com/OpceanAI/Doki"
arch="x86_64 aarch64 armv7"
license="GPL-3.0-only"
depends=""
options="!check"
source="https://github.com/OpceanAI/DokiOS/releases/download/v$pkgver/doki-init-$pkgver-$CARCH.tar.gz"

package() {
	install -Dm755 "$srcdir"/doki-init "$pkgdir"/sbin/doki-init
	# doki-init as /sbin/init
	ln -sf doki-init "$pkgdir"/sbin/init
}

sha512sums="
"
