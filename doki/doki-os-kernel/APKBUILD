# Maintainer: Doki Team <team@doki.opceanai.com>
pkgname=doki-os-kernel
pkgver=7.0.12
_kernver=${pkgver%.*}
_flavor=doki-os
pkgrel=0
pkgdesc="doki-OS container-optimized kernel"
url="https://www.kernel.org"
arch="x86_64 aarch64 armv7"
license="GPL-2.0-only"
depends="initramfs-generator"
makedepends="perl gmp-dev mpc1-dev mpfr-dev elfutils-dev bash flex bison
	zstd installkernel bc linux-headers linux-firmware-any openssl-dev>3
	mawk diffutils findutils pahole python3 gcc>=13.1.1_git20230624 bpftool"
options="!strip !check"
source="https://cdn.kernel.org/pub/linux/kernel/v${_kernver%%.*}.x/linux-$_kernver.tar.xz
	doki-os.x86_64.config
	doki-os.aarch64.config
	doki-os.armv7.config"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"

build() {
	unset LDFLAGS
	cd "$builddir"
	cp "$srcdir"/doki-os.$CARCH.config .config
	make olddefconfig
	make -j$(nproc)
}

package() {
	install -Dm644 "$builddir"/arch/*/boot/Image.gz \
		"$pkgdir"/boot/vmlinuz-$_flavor
	install -Dm644 "$builddir"/System.map \
		"$pkgdir"/boot/System.map-$_flavor
	# Install kernel modules
	make INSTALL_MOD_PATH="$pkgdir" modules_install
	# Strip debug info from modules
	find "$pkgdir" -name '*.ko' -exec strip --strip-debug {} \; 2>/dev/null || true
}

sha512sums="
"
