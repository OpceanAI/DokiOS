pkgname=doki-kubectl
pkgver=0.9.5
pkgrel=0
pkgdesc="kubectl compatible CLI for Doki Kubernetes"
url="https://github.com/OpceanAI/Doki"
arch="x86_64 aarch64 armv7"
license="GPL-3.0-only"
depends=""
options="!check"
source="https://github.com/OpceanAI/DokiOS/releases/download/v$pkgver/doki-kubectl-$pkgver-$CARCH.tar.gz"

package() {
	install -Dm755 "$srcdir"/doki-kubectl "$pkgdir"/usr/bin/doki-kubectl
	# Also provide as kubectl for compatibility
	ln -sf doki-kubectl "$pkgdir"/usr/bin/kubectl
}

sha512sums="
"
